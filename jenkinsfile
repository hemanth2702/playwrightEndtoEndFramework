pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['qa', 'stage', 'dev'],
            description: 'Select environment'
        )
    }

    options {

        timestamps()

        timeout(
            time: 15,
            unit: 'MINUTES'
        )
    }

    stages {

        // ==========================================
        // 1. CHECKOUT CODE
        // ==========================================

        stage('Checkout Code') {

            steps {

                echo '======================================'
                echo 'CHECKOUT CODE'
                echo '======================================'

                git(
                    url: 'https://github.com/hemanth2702/playwrightEndtoEndFramework.git',
                    branch: 'master'
                )
            }
        }


        // ==========================================
        // 2. CHECK NODE
        // ==========================================

        stage('Check Node') {

            steps {

                echo '======================================'
                echo 'CHECK NODE SETUP'
                echo '======================================'

                nodejs('Nodejs24') {

                    bat '''
                        node --version
                        npm --version
                         where node
                        where npm
                    '''
                }
            }
        }


        // ==========================================
        // 3. INSTALL DEPENDENCIES
        // ==========================================

        stage('Install Dependencies') {

            steps {

                echo '======================================'
                echo 'INSTALL DEPENDENCIES'
                echo '======================================'

                nodejs('Nodejs24') {

                    bat '''
                        npm ci
                    '''
                }
            }
        }


        // ==========================================
        // 4. INSTALL PLAYWRIGHT
        // ==========================================

        stage('Install Playwright') {

            steps {

                echo '======================================'
                echo 'INSTALL PLAYWRIGHT CHROMIUM'
                echo '======================================'

                nodejs('Nodejs24') {

                    bat '''
                        npx playwright install chromium
                    '''
                }
            }
        }


        // ==========================================
        // 5. VERIFY ENVIRONMENT
        // ==========================================

        stage('Verify Environment') {

            steps {

                echo '======================================'
                echo 'VERIFY ENVIRONMENT'
                echo '======================================'

                withCredentials([

                    string(
                        credentialsId: 'APP_URL',
                        variable: 'APP_URL'
                    )

                ]) {

                    nodejs('Nodejs24') {

                        bat '''
                            echo Environment will be configured from Jenkins credentials.

                            if defined APP_URL (
                                echo APP_URL is available
                            ) else (
                                echo APP_URL is NOT available
                                exit /b 1
                            )
                        '''
                    }
                }
            }
        }


        // ==========================================
        // 6. RUN PLAYWRIGHT UI TESTS
        // ==========================================

        stage('Run UI Tests') {

            steps {

                echo '======================================'
                echo 'RUN PLAYWRIGHT UI TESTS'
                echo '======================================'

                echo "Environment: ${params.ENVIRONMENT}"

                withCredentials([

                    string(
                        credentialsId: 'APP_URL',
                        variable: 'APP_URL'
                    ),

                    string(
                        credentialsId: 'APPUSERNAME',
                        variable: 'APPUSERNAME'
                    ),

                    string(
                        credentialsId: 'APPPASSWORD',
                        variable: 'APPPASSWORD'
                    ),

                    // string(
                    //     credentialsId: 'product',
                    //     variable: 'PRODUCT'
                    // ),

                    // string(
                    //     credentialsId: 'first-name',
                    //     variable: 'FN'
                    // ),

                    // string(
                    //     credentialsId: 'last-name',
                    //     variable: 'LN'
                    // ),

                    // string(
                    //     credentialsId: 'postal-code',
                    //     variable: 'PC'
                    // ),

                    string(
                        credentialsId: 'API_URL',
                        variable: 'API_URL'
                    ),

                    string(
                        credentialsId: 'ACCESSTOKEN',
                        variable: 'ACCESSTOKEN'
                    )

                ]) {

                    nodejs('Nodejs24') {

                        bat """
                            set ENV=${params.ENVIRONMENT.toLowerCase()}

                            echo Environment configured: %ENV%

                            npx playwright test --project=ui
                        """
                    }
                }
            }
        }


        // ==========================================
        // 7. GENERATE ALLURE REPORT
        // ==========================================

        stage('Generate Allure Report') {

            steps {

                echo '======================================'
                echo 'GENERATE ALLURE REPORT'
                echo '======================================'

                nodejs('Nodejs24') {

                    bat '''
                        npx allure generate allure-results -o allure-report --clean
                    '''
                }
            }
        }


        // ==========================================
        // 8. CUSTOMIZE ALLURE REPORT
        // ==========================================

        stage('Customize Allure Report') {

            steps {

                echo '======================================'
                echo 'CUSTOMIZE ALLURE REPORT'
                echo '======================================'

                nodejs('Nodejs24') {

                    bat '''
                        node src/allure/customize-allure-report.js
                    '''
                }
            }
        }


        // ==========================================
        // 9. PUBLISH ALLURE REPORT
        // ==========================================

        stage('Publish Allure Report') {

            steps {

                echo '======================================'
                echo 'PUBLISH ALLURE REPORT'
                echo '======================================'

                allure([
                    includeProperties: false,
                    results: [
                        [path: 'allure-results']
                    ]
                ])
            }
        }


        // ==========================================
        // 10. ARCHIVE REPORTS
        // ==========================================

        stage('Archive Reports') {

            steps {

                echo '======================================'
                echo 'ARCHIVE REPORTS'
                echo '======================================'

                archiveArtifacts(
                    artifacts: '''
                        allure-results/**,
                        allure-report/**,
                        reports/html-report/**
                    ''',

                    allowEmptyArchive: true,

                    fingerprint: true
                )
            }
        }
    }


    // ==============================================
    // POST EXECUTION
    // ==============================================

    post {

        always {

            echo '======================================'
            echo 'PIPELINE SUMMARY'
            echo '======================================'

            echo "Environment: ${params.ENVIRONMENT}"

            echo "Build Number: ${BUILD_NUMBER}"

            echo "Build Result: ${currentBuild.currentResult}"

            echo "Build URL: ${BUILD_URL}"

            // Archive reports generated before a failure
            archiveArtifacts(
                artifacts: 'allure-results/**,allure-report/**,reports/html-report/**',
                allowEmptyArchive: true,
                fingerprint: true
            )

            // EMAIL NOTIFICATION
            script {
                def finalStatus = currentBuild.currentResult

                try {
                    withCredentials([
                        string(
                            credentialsId: 'MAIL_USERNAME',
                            variable: 'MAIL_USERNAME'
                        ),
                        string(
                            credentialsId: 'MAIL_APP_PASSWORD',
                            variable: 'MAIL_APP_PASSWORD'
                        ),
                        string(
                            credentialsId: 'RECIPIENT_EMAILS',
                            variable: 'RECIPIENT_EMAILS'
                        )
                    ]) {
                        withEnv([
                            "BUILD_STATUS=${finalStatus}",
                            "TEST_ENVIRONMENT=${params.ENVIRONMENT}",
                            "BUILD_NUMBER=${env.BUILD_NUMBER}",
                            "BUILD_URL=${env.BUILD_URL}",
                            "ALLURE_REPORT_URL=${env.BUILD_URL}allure/"
                        ]) {
                            nodejs('Nodejs24') {
                                def emailExitCode = bat(
                                    script: 'npx tsx src/email/send-report-email.ts',
                                    returnStatus: true
                                )

                                if (emailExitCode != 0) {
                                    echo 'WARNING: Email notification failed. Check the email logs.'
                                } else {
                                    echo 'Email script completed successfully.'
                                }
                            }
                        }
                    }
                } catch (Exception e) {
                    echo "WARNING: Email notification error: ${e.getMessage()}"
                }
            }
        }


        success {

            echo '======================================'
            echo '✅ PLAYWRIGHT PIPELINE PASSED'
            echo '======================================'
        }


        failure {

            echo '======================================'
            echo '❌ PLAYWRIGHT PIPELINE FAILED'
            echo '======================================'
        }
    }
}